<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<link name="world"/>
    <link name="base"/>
    <gazebo reference="base">
        <static>true</static>
    </gazebo>
    <xacro:fixed_joint
    name="world_frame"
    parent="world"
    child="base"
    x="0"
    y="0"
    z="0"/>
</robot>